<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Kopfzeile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:contentDescription="Zurück"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="Kamera" />

        <Button
            android:id="@+id/btnSave"
            style="@style/BarButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:background="@drawable/btn_primary"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="Speichern"
            android:textColor="#000000" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="16dp">

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp">
                <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verbindung" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Name" />
                <EditText android:id="@+id/etName" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="z. B. Einfahrt, Haustür" android:inputType="textCapSentences" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IP-Adresse" />
                <EditText android:id="@+id/etHost" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="z. B. 192.168.1.50" android:inputType="textUri" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="8dp" android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Benutzer" />
                        <EditText android:id="@+id/etUser" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="admin" android:inputType="text" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Passwort" />
                        <EditText android:id="@+id/etPass" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
                    </LinearLayout>
                </LinearLayout>

                <CheckBox android:id="@+id/cbHttps" style="@style/Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="HTTPS verwenden (Standard bei neuer Firmware)" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="8dp" android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HTTP(S)-Port" />
                        <EditText android:id="@+id/etHttpPort" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Standard" android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RTSP-Port" />
                        <EditText android:id="@+id/etRtspPort" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="554" android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <Button android:id="@+id/btnTest" style="@style/BarButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/chip" android:text="Verbindung testen" />
                <TextView android:id="@+id/tvTest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/textDim" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verhalten" />
                <CheckBox android:id="@+id/cbDoorbell" style="@style/Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ist eine Türklingel (Bildschirm beim Läuten einschalten)" />
                <CheckBox android:id="@+id/cbWake" style="@style/Option" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bewegung dieser Kamera schaltet den Bildschirm ein" />
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Erweitert" />
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eigener RTSP-Pfad oder komplette RTSP-URL (leer = automatisch)" />
                <EditText android:id="@+id/etRtspPath" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="z. B. h264Preview_01_sub oder rtsp://…" android:inputType="textUri" android:imeOptions="actionDone" />
            </LinearLayout>

            <Button android:id="@+id/btnDelete" style="@style/BarButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/chip" android:text="Kamera entfernen" android:textColor="@color/motion" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
