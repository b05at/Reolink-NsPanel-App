<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:shutter_background_color="@color/bg" />

    <!-- Fängt Berührungen ab: Tippen zeigt/versteckt die Bedienung -->
    <View
        android:id="@+id/touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Übersicht mehrerer Kameras -->
    <at.reolinkpanel.viewer.DashboardView
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="2dp"
        android:paddingTop="2dp"
        android:paddingRight="2dp"
        android:paddingBottom="70dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:background="@drawable/pill"
        android:gravity="center"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:text="Verbinde…"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/motionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="66dp"
        android:background="@drawable/badge_motion"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:text="● BEWEGUNG"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Oben links: Übersicht + Kamerawahl -->
    <LinearLayout
        android:id="@+id/topLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_margin="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnGrid"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/fab_dark"
            android:contentDescription="Übersicht"
            android:scaleType="center"
            android:src="@drawable/ic_grid"
            android:tint="@color/icon_tint" />

        <TextView
            android:id="@+id/camChip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bar_pill"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxWidth="120dp"
            android:paddingLeft="14dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:text="Kamera ▾"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Oben rechts: Scheinwerfer + Sirene -->
    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_margin="10dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnLight"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/fab_dark"
            android:contentDescription="Scheinwerfer"
            android:scaleType="center"
            android:src="@drawable/ic_light"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/btnSiren"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/fab_dark"
            android:contentDescription="Sirene"
            android:scaleType="center"
            android:src="@drawable/ic_siren"
            android:tint="@color/text" />
    </LinearLayout>

    <!-- Einblendbares Steuerkreuz -->
    <LinearLayout
        android:id="@+id/ptzPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <at.reolinkpanel.viewer.DPadView
            android:id="@+id/dpad"
            android:layout_width="150dp"
            android:layout_height="150dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bar_pill"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btnZoomIn"
                style="@style/IconButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Zoom +"
                android:src="@drawable/ic_plus" />

            <ImageButton
                android:id="@+id/btnZoomOut"
                style="@style/IconButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Zoom −"
                android:src="@drawable/ic_minus" />

            <ImageButton
                android:id="@+id/btnPtzClose"
                style="@style/IconButton"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Schließen"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

    <!-- Schwebende Bedienleiste -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bar_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnRec"
            style="@style/IconButton"
            android:contentDescription="Aufnahmen"
            android:src="@drawable/ic_library" />

        <ImageButton
            android:id="@+id/btnSound"
            style="@style/IconButton"
            android:contentDescription="Ton"
            android:src="@drawable/ic_volume_off" />

        <TextView
            android:id="@+id/btnStream"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp"
            android:background="@drawable/icon_btn"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="SD"
            android:textColor="@color/icon_tint"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnZoom"
            style="@style/IconButton"
            android:contentDescription="Bild füllen"
            android:src="@drawable/ic_fill" />

        <ImageButton
            android:id="@+id/btnPtz"
            style="@style/IconButton"
            android:contentDescription="Schwenken"
            android:src="@drawable/ic_ptz" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/IconButton"
            android:contentDescription="Einstellungen"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Ruhemodus: schwarz, Berührung weckt das Display -->
    <View
        android:id="@+id/sleepOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />
</FrameLayout>
