<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:shutter_background_color="@color/bg" />

    <!-- Fängt Berührungen ab: Tippen zeigt/versteckt die Bedienung -->
    <View
        android:id="@+id/touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:background="@drawable/pill"
        android:gravity="center"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingRight="14dp"
        android:paddingBottom="8dp"
        android:text="Verbinde…"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/motionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/badge_motion"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:text="BEWEGUNG"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Rechte Seite: Schwenken und Sirene -->
    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="6dp"
        android:layout_marginRight="4dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPtz"
            style="@style/BarButton"
            android:layout_width="84dp"
            android:layout_height="52dp"
            android:text="Schwenken"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSiren"
            style="@style/BarButton"
            android:layout_width="84dp"
            android:layout_height="52dp"
            android:singleLine="false"
            android:maxLines="2"
            android:text="Sirene"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Einblendbares Steuerkreuz -->
    <LinearLayout
        android:id="@+id/ptzPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="66dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <at.reolinkpanel.viewer.DPadView
            android:id="@+id/dpad"
            android:layout_width="150dp"
            android:layout_height="150dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnZoomIn"
                style="@style/BarButton"
                android:layout_width="52dp"
                android:layout_height="46dp"
                android:text="+"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnZoomOut"
                style="@style/BarButton"
                android:layout_width="52dp"
                android:layout_height="46dp"
                android:text="−"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnPtzClose"
                style="@style/BarButton"
                android:layout_width="52dp"
                android:layout_height="46dp"
                android:text="✕"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bar"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnRec"
            style="@style/BarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:text="Aufnahmen" />

        <Button
            android:id="@+id/btnSound"
            style="@style/BarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Ton aus" />

        <Button
            android:id="@+id/btnStream"
            style="@style/BarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="SD" />

        <Button
            android:id="@+id/btnZoom"
            style="@style/BarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="Ganz" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/BarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:text="⚙"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
