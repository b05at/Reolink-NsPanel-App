<?xml version="1.0" encoding="utf-8"?>
<!-- Runder Icon-Knopf: aktiviert = blau hinterlegt (kein Rot/Grün) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#554FA3F7" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval"><solid android:color="#334FA3F7" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#00000000" /></shape>
    </item>
</selector>
